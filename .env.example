# Every variable this site reads. Copy to .env.local for development.
#
# NOTHING in this file is a real value, and no file holding real values belongs
# in the repository. On Vercel these live in Project Settings → Environment
# Variables, set separately for Production, Preview and Development. That is the
# only place they should exist for the deployed site.
#
# NEXT_PUBLIC_ is not a naming convention — it is an instruction. Anything with
# that prefix is compiled into the JavaScript sent to the browser and is
# readable by anyone who opens devtools. Never give a secret that prefix.

# ── Public: safe in the browser ──────────────────────────────────────────────

# Where the CMS lives. No trailing slash — one produces "//api/..." and every
# product fetch 404s.
NEXT_PUBLIC_BASE_URL="https://cms.sensohearingdhaka.com"

# Google Analytics measurement id. Currently set but read by nothing — there is
# no analytics on this site. Wiring it up means adding it to the privacy notice
# in the same commit, because it becomes a third party receiving visitor data.
NEXT_PUBLIC_GTM=""

# ── Server only: never prefixed, never in the browser ────────────────────────

# The model behind Naati. MUST be a billed key before real patients use the
# site — on the free tier Google's terms permit training on what is sent, and
# what is sent includes photographs of prescriptions.
GEMINI_API_KEY=""

# The clinic's admin server, for appointment booking. Leave the key empty and
# booking switches itself off cleanly: the assistant falls back to the phone
# number instead of failing.
SENSO_ADMIN_API_URL="https://admin.sensohearingdhaka.com/api/public"
SENSO_ADMIN_API_KEY=""
SENSO_ADMIN_API_HEADER="X-Senso-Key"

# Optional. Off by default: with no URL set, nothing about any conversation is
# stored anywhere. Switching it on changes what the privacy notice must say.
NAATI_TRANSCRIPT_URL=""
NAATI_TRANSCRIPT_TOKEN=""

# Optional model overrides. Defaults are in src/lib/naati/engine/model.ts.
NAATI_TEXT_MODEL=""
NAATI_VISION_MODEL=""
NAATI_TOOL_MODEL=""
